define ('CUSTOM_END_FIELDSET', 'custom_end_fieldset');


function custom_preprocess_page(&$variables) {
  $variables['#attached']['library'][] = 'custom/listingform';
}

/**
 * Implements hook_help().
 */
function custom_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the custom module.
    case 'help.page.custom':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Custom code for RealtyPro') . '</p>';
      return $output;

    default:
  }
}

/**
* Implements hook_entity_info_alter().
*/
function custom_entity_info_alter(&$entity_info) {
  $entity_info['node']['view modes']['page_width'] = array(
    'label' => t('Page Width'),
    'custom settings' => TRUE,
  );
}

/**
 * Impleements hook_form_BASE_FORM_ID_alter
 *
 */

function custom_form_alter (&$form, &$form_state, $form_id) {
  
}

/**
 * Impleements hook_form_BASE_FORM_ID_alter
 *
 */

function custom_form_views_exposed_form_alter (&$form, &$form_state) {

  /** @var \Drupal\views\ViewExecutable $view */
  $view = $form_state->get('view');
  $view_id = $view->id(); $display = $view->getDisplay()->getPluginId();
  if ($view->id() == 'listings_new' && $view->getDisplay()->getPluginId() == 'page') {
    $form['field_start_date_value']['#type'] = 'date';
    $form['field_end_date_value']['#type'] = 'date';
  }
//var_dump (['viewId' => $view_id, 'display' => $display, 'form' => $form]);
  if (isset($form['field_selling_agent_target_id'])) {
    // get list of agents
    $connection = Database::getConnection();
    $agents = $connection->select('node_field_data', 'nfd')
      ->fields('nfd', array('nid', 'title'))
      ->condition('nfd.type', 'agent')
      ->orderBy('title', 'ASC')
      ->execute()
      ->fetchAll();
      
    $options = array('NULL' => '-Select Agent-');
    foreach ($agents as $agent) {
      $options[$agent->nid] = $agent->title . ":" . $agent->nid;
    }
    $form['select_agent'] = array(
      '#type' => 'select',
      '#title' => 'Selling Agent',
      '#options' => $options,
      '#value' => 'all',
    );
  }
  //$form['#validate'][] = '_custom_exposed_filter_date_handling';
}

function _custom_build_year_select() {
  $options = array();
  $start = 2000;
  $end = date('Y');
  for ($count = $start; $count <= $end; $count++) {
    $options [$count] = $count;
  }
  return $options;
}


